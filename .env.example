# LearnPilot Environment Configuration
# LLM Provider API Keys (Server-Side Only - Never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Model override (defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional: LLM Base URL override for proxies or enterprise gateways
# LLM_BASE_URL=https://generativelanguage.googleapis.com

# Node Environment
NODE_ENV=development
